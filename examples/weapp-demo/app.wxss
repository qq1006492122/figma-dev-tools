/* app.wxss - 全局样式 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  color: #333333;
  background-color: #f5f5f5;
  box-sizing: border-box;
}

view, text, image, button, input, navigator {
  box-sizing: border-box;
}

.container {
  padding: 32rpx;
}
