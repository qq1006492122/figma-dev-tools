/* index.wxss */
/* 750rpx 设计稿基准：375pt 帧下 1px = 2rpx */

.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 64rpx;
  box-sizing: border-box;
  background-color: #f6f7fa;
}

/* —— 头部 —— */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 40rpx;
}

.hero-logo {
  width: 128rpx;
  height: 128rpx;
  border-radius: 28rpx;
}

.hero-title {
  margin-top: 20rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.hero-subtitle {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #8a8f99;
}

/* —— 搜索表单 —— */
.search-form {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.search-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1a1a1a;
  background-color: #f3f4f7;
  border-radius: 36rpx;
}

.search-btn {
  width: 144rpx;
  height: 72rpx;
  margin: 0;
  padding: 0;
  line-height: 72rpx;
  font-size: 28rpx;
  color: #ffffff;
  background-color: #07c160;
  border-radius: 36rpx;
}

.search-btn::after {
  border: none;
}

/* —— 过滤行 —— */
.filter-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 8rpx 24rpx;
}

.filter-switch {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.filter-switch__switch {
  transform: scale(0.85);
}

.filter-label {
  margin-left: 8rpx;
  font-size: 26rpx;
  color: #4a4f59;
}

.filter-right {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
}

.result-count {
  font-size: 24rpx;
  color: #8a8f99;
}

.reset-link {
  font-size: 24rpx;
  color: #5e9eff;
}

/* —— 商品列表 —— */
.goods-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.goods-card {
  display: flex;
  flex-direction: row;
  padding: 20rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.goods-image {
  width: 180rpx;
  height: 180rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  background-color: #eef0f4;
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  margin-left: 20rpx;
}

.goods-name-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.goods-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.stock-tag {
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  border-radius: 8rpx;
}

.stock-tag--ok {
  color: #07c160;
  background-color: #e6f8ef;
}

.stock-tag--out {
  color: #9aa0aa;
  background-color: #f0f1f5;
}

.goods-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  color: #8a8f99;
}

.goods-bottom {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.goods-price {
  font-size: 34rpx;
  font-weight: 700;
  color: #e04536;
}

.add-btn {
  margin: 0;
  padding: 0 20rpx;
  font-size: 24rpx;
  color: #ffffff;
  background-color: #07c160;
  border-radius: 28rpx;
}

.add-btn::after {
  border: none;
}

.add-btn--disabled {
  background-color: #b9bdc6;
}

/* —— 空态条件块 —— */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 32rpx;
}

.empty-image {
  width: 200rpx;
  height: 200rpx;
  opacity: 0.8;
}

.empty-title {
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #4a4f59;
}

.empty-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #8a8f99;
}

.empty-btn {
  margin-top: 32rpx;
  padding: 0 32rpx;
  font-size: 26rpx;
  color: #07c160;
  background-color: #e6f8ef;
  border-radius: 32rpx;
}

.empty-btn::after {
  border: none;
}
