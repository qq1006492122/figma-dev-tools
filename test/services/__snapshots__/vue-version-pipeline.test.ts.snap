  label?: string;
  /** Disabled —— Figma BOOLEAN 开关属性。@default false */
  disabled?: boolean;
  /** Size —— Figma VARIANT 变体属性。@default "medium" */
  size?: 'small' | 'medium' | 'large';
  /** Leading Icon —— Figma INSTANCE_SWAP 可交换组件。可交换 key：ICON:1 */
  leadingIcon: Component;
}

const props = withDefaults(defineProps<Props>(), {
  class: '',
  label: 'Confirm',
  disabled: false,
  size: 'medium',
});

