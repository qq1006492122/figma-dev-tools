exports[`TR-6.1 zh-CN 全命令 --help > 全部中文 help 聚合快照 1`] = `
{
  "(root)": "Usage: figma-dev [options] [command]

Figma 开发工具 - 设计稿与代码的桥接工具

Options:
  -V, --version                           output the version number
  -t, --token <token>                     Figma Access Token
  -o, --output <dir>                      输出目录 (default: "./src/styles/figma")
  --no-backup                             不创建备份文件
  -l, --lang <lang>                       显示语言 (zh-CN/en-US)
  -v, --ver                               显示版本号
  --update                                检查并更新到最新版本
  -h, --help                              display help for command

Commands:
  lang                                    切换显示语言
  validate                                验证 Figma Access Token 是否有效
  token                                   安全管理 Figma Access Token
  info <url-or-filekey>                   查看 Figma 文件信息
  sync [options] <url-or-filekey>         同步设计 Tokens 到本地项目
  component [options] <url-or-figma-url>  从 Figma 节点生成 React 组件代码
  screenshot [options] <url-or-filekey>   获取节点截图
  metadata [options] <url-or-filekey>     获取设计节点高层结构概览（避免上下文爆炸）
  lint [options] <url-or-filekey>         检查 Figma 设计稿的代码还原质量（代码生成前预检）
  structured [options] <url-or-filekey>   获取框架无关的结构化设计数据（适用于 Vue/Svelte/HTML 等任意框架）
  jsx [options] <url-or-filekey>          一键生成 React/Vue + Tailwind/UnoCSS 组件代码（vX.Y.Z 增强版）
  vue [options] <url-or-filekey>          一键生成 Vue 2/3 SFC 组件（.vue 单文件，vX.Y.Z 新增）
  svelte [options] <url-or-filekey>       一键生成 Svelte 4 组件（.svelte 单文件；样式仅 tailwind/unocss/css-modules，vX.Y.Z 新增）
  batch [options] <url-or-filekey>        整页区块拆分并批量生成多文件组件（含 index.ts barrel 与依赖图，vX.Y.Z 新增）
  weapp [options] <url-or-filekey>        生成微信小程序组件代码（WXML + WXSS + JS + JSON）
  assets [options] <url-or-filekey>       下载设计资源到项目资源目录（vX.Y.Z 起按构建器落位 public/ 或 src/assets/）
  tutorial|help [options]                 打开 Figma Dev Tools 教程和文档
  mcp                                     启动 MCP 服务器 (stdio 模式)
  wizard|init [options]                   交互式配置向导（推荐首次使用时运行）
  gui                                     启动 GUI 可视化配置面板
  cache                                   管理本地缓存
  privacy                                 查看隐私承诺声明
示例:
  $ figma-dev wizard                        # 交互式初始化配置
  $ figma-dev sync "https://figma.com/design/xxx" -o ./src/styles
  $ figma-dev jsx <文件链接> --node 1:2 --style tailwind
  $ figma-dev -l en-US --help               # 临时切换为英文帮助

Shell 自动补全:
  安装补全脚本（执行一次即可）:
    figma-dev completion >> ~/.zshrc     # Zsh
    figma-dev completion >> ~/.bashrc    # Bash
    figma-dev completion | Out-String | Invoke-Expression  # PowerShell

  安装后重启终端即可使用 Tab 键自动补全命令和选项。

",
  "assets": "Usage: figma-dev assets [options] <url-or-filekey>

下载设计资源到项目资源目录（vX.Y.Z 起按构建器落位 public/ 或 src/assets/）

Options:
  -n, --node <nodeId>    节点 ID（可指定多个，逗号分隔）
  --nodes <nodeIds>      节点 ID 列表（逗号分隔）
  --scene <scene>        场景名称（如 health、edu、ai-innovation-class） (default:
                         "default")
  --project-root <dir>   项目根目录（自动检测）
  --scale <scale>        缩放比例 (1-4) (default: "2")
  --svg-format <format>  矢量导出格式 (svg/png) (default: "svg")
  --bundler <bundler>    目标项目构建器（vX.Y.Z）: auto (默认，自动检测) | vite | webpack |
                         nextjs | remix | none（旧版 publicCdnUrl） (default:
                         "auto")
  -h, --help             display help for command
示例:
  $ figma-dev assets <设计稿链接> -o ./public/assets
  $ figma-dev assets <fileKey> --node 1:2 --format svg --bundler vite
",
  "batch": "Usage: figma-dev batch [options] <url-or-filekey>

整页区块拆分并批量生成多文件组件（含 index.ts barrel 与依赖图，vX.Y.Z 新增）

Options:
  -n, --node <nodeId>         指定节点 ID
  --nodes <ids>               逗号分隔的区块节点 ID（省略则自动拆分整页）
  --out <dir>                 多文件输出目录（默认 ./figma-generated） (default:
                              "figma-generated")
  --prefix <prefix>           所有区块组件名统一前缀（ASCII，如 Landing）
  --depth <depth>             最大节点树深度 (default: "15")
  --framework <framework>     目标框架: react (默认) | vue (default: "react")
  --style <styleFormat>       样式方案（默认 tailwind）。可用：tailwind (Tailwind
                              CSS)、unocss (UnoCSS)、css-modules (CSS
                              Modules)、styled (Styled Components)、emotion
                              (Emotion)、less (Less)、sass
                              (Sass/SCSS)、vanilla-extract
                              (vanilla-extract)、panda (Panda CSS)、inline-styles
                              (内联样式)；计划中：css-variables（vX.Y.Z） (default:
                              "tailwind")
  --component-library <name>  组件库映射: auto (按 package.json/components.json 自动检测)
                              | none (默认，原生标签) | shadcn-ui |
                              ant-design（React）；element-plus |
                              ant-design-vue（Vue） (default: "none")
  --attributify               UnoCSS attributify 模式（vX.Y.Z新增，仅配合 --style
                              unocss；原子类以元素属性输出，默认关闭=wind 模式） (default: false)
  --bundler <bundler>         目标项目构建器（vX.Y.Z）: auto (默认，自动检测) | vite | webpack
                              | nextjs | remix | none（旧版 publicCdnUrl）
                              (default: "auto")
  --vue-version <version>     Vue 大版本: 2 (Options API) | 3 (默认，<script setup>)
                              (default: "3")
  --no-smart-grid             关闭 T21 布局推断（Grid/sticky/fixed/absolute，默认开）/
                              Disable grid inference (vX.Y.Z)
  --no-smart-icons            关闭 T21 图标识别建议（默认开）/ Disable icon inference
                              (vX.Y.Z)
  --no-smart-dark             关闭 T21 深色模式策略建议（默认开）/ Disable dark-mode inference
                              (vX.Y.Z)
  --no-smart-motion           关闭 T21 交互动效建议（默认开）/ Disable motion inference
                              (vX.Y.Z)
  -h, --help                  display help for command
示例:
  $ figma-dev batch <整页链接> --out ./src/components/landing  # 自动拆分 header/hero/... 多文件
  $ figma-dev batch <链接> --nodes 1:10,1:11 --framework vue   # 仅生成指定区块（Vue SFC）
  $ figma-dev batch <链接> --prefix Landing --style css-modules
",
  "cache": "Usage: figma-dev cache [options] [command]

管理本地缓存

Options:
