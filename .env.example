# ============================================
# Figma Dev Tools 环境变量配置
# 使用方法：复制此文件为 .env 并填写实际值
# 注意：.env 文件包含敏感信息，不要提交到 Git！
# ============================================

# ------------------------------------------
# 【必需】Figma Personal Access Token
# 获取方式：
#   1. 登录 https://www.figma.com
#   2. 右上角头像 → Settings → Account
#   3. Personal access tokens → Generate new token
#   4. 勾选权限：File content (Read only)
#   5. 复制生成的 Token（只显示一次！）
# 格式：figd_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ------------------------------------------
FIGMA_ACCESS_TOKEN=your-figma-access-token-here

# ------------------------------------------
# 【可选】Figma OAuth Token
# 适用于企业版 Figma 使用 OAuth 认证的场景
# 一般用户无需配置，留空即可
# ------------------------------------------
FIGMA_OAUTH_TOKEN=

# ------------------------------------------
# 【可选】Figma API 基础地址
# 默认：https://api.figma.com
# 企业版用户如需通过代理访问可自定义
# ------------------------------------------
FIGMA_API_BASE=https://api.figma.com

# ------------------------------------------
# 【可选】默认导出图片倍率
# 取值范围：1 / 2 / 3 / 4
# 默认值：2（2x 高清，兼顾清晰度和文件大小）
# 1x = 标准清晰度，4x = 最高清晰度（文件大）
# ------------------------------------------
FIGMA_DEFAULT_SCALE=2

# ------------------------------------------
# 【可选】默认颜色输出格式
# 可选值：hex / rgb / oklch / hsl
# 默认值：oklch（Tailwind CSS v4 原生支持，色域最大）
# 如果 oklch 在你的项目中显示有问题，可改为 hex
# ------------------------------------------
FIGMA_DEFAULT_COLOR_FORMAT=oklch

# ------------------------------------------
# 【可选】资源文件输出基础目录
# 默认值：public（Vite/Next.js 项目的静态资源目录）
# 图片/SVG 会下载到 {FIGMA_ASSETS_BASE_DIR}/<场景名>/ 下
# ------------------------------------------
FIGMA_ASSETS_BASE_DIR=public

# ------------------------------------------
# 【可选】静态资源 CDN 前缀
# 默认值：/（相对路径）
# 如果你的项目部署在 CDN 上，配置 CDN 的 URL 前缀
# 例如：https://cdn.example.com/static
# ------------------------------------------
FIGMA_CDN_PREFIX=/

# ------------------------------------------
# 【可选】默认间距单位
# 可选值：px / rem
# 默认值：px
# ------------------------------------------
FIGMA_DEFAULT_SPACING_UNIT=px

# ------------------------------------------
# 【可选】是否在写入文件前自动备份
# 默认值：true
# 同步 Tokens 到项目时，会自动备份原有文件
# ------------------------------------------
FIGMA_BACKUP_FILES=true

# ------------------------------------------
# 【可选】自定义 CA 根证书路径（PEM 格式，v1.4.18 新增）
# 适用场景：企业内网使用私有根 CA / HTTPS 解密代理（MITM），
#           导致默认信任链无法校验 api.figma.com 等证书时。
# 配置后：在系统内置根证书之外，额外信任该 PEM 证书；
#         Figma API（axios）与 OCR 远程图片下载均生效。
# 要求：文件必须存在且包含 "BEGIN CERTIFICATE" 标记，
#       否则工具启动请求时会直接报错（不会静默忽略）。
# 未配置：行为与旧版本完全一致。
# ------------------------------------------
# FIGMA_CA_CERT_PATH=/path/to/corporate-root-ca.pem
