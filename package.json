{
  "name": "figma-dev-tools",
  "version": "1.0.1",
  "description": "Figma Dev Tools MCP Server - Bridge Figma designs to code with AI-powered token extraction, component generation (React+Tailwind), asset downloads, and one-click installation across Trae, VS Code, Cursor, Windsurf, and Claude Desktop.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "figma-dev": "./bin/figma-dev.js",
    "figma-dev-tools": "./bin/figma-dev.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "cli": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup": "node install.mjs",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "figma",
    "mcp",
    "model-context-protocol",
    "design-to-code",
    "design-tokens",
    "tailwind",
    "react",
    "ai-editor",
    "claude",
    "cursor",
    "trae",
    "vscode",
    "windsurf"
  ],
  "author": "Youcha",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/shanxi-youcha/figma-dev-tools.git"
  },
  "files": [
    "dist",
    "bin",
    "install.mjs",
    "install.sh",
    "uninstall.mjs",
    "uninstall.sh",
    "mcp-config.schema.json",
    ".env.example",
    "README.md",
    "SKILL.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "axios": "^1.7.9",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "fast-glob": "^3.3.2",
    "fs-extra": "^11.2.0",
    "js-yaml": "^4.1.0",
    "json5": "^2.2.3",
    "lodash-es": "^4.17.21",
    "prettier": "^3.4.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.10.0",
    "@types/prettier": "^3.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "homepage": "https://gitee.com/shanxi-youcha/figma-dev-tools",
  "bugs": {
    "url": "https://gitee.com/shanxi-youcha/figma-dev-tools/issues"
  },
  "types": "dist/index.d.ts"
}
