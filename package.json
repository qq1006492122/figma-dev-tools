{
  "name": "figma-dev-tools",
  "version": "1.2.0",
  "description": "Figma Dev Tools MCP Server - Bridge Figma designs to code with AI-powered token extraction, framework-agnostic structured data, React/Vue/HTML component generation, asset downloads, and one-click installation across 10+ editors. Features i18n, a11y (accessibility), responsive design inference, design system alignment, flex layout fixes, zero-config npx mode with --figma-api-key, secure token storage, interactive wizard CLI, Prettier auto-formatting, SVG sprite generation, Tailwind class merging with tailwind-merge",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "figma-dev": "./bin/figma-dev.js",
    "figma-dev-tools": "./bin/figma-dev.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "cli": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup": "node install.mjs",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "figma",
    "mcp",
    "model-context-protocol",
    "design-to-code",
    "design-tokens",
    "tailwind",
    "react",
    "ai-editor",
    "claude",
    "cursor",
    "trae",
    "vscode",
    "windsurf",
    "pnpm",
    "vue",
    "svelte",
    "html",
    "zed",
    "cline",
    "roo-code",
    "framework-agnostic",
    "zero-config",
    "yarn",
    "bun",
    "i18n",
    "a11y",
    "accessibility",
    "responsive",
    "design-system",
    "flex-fixer",
    "responsive-design",
    "flexbox"
  ],
  "author": "Youcha",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/shanxi-youcha/figma-dev-tools.git"
  },
  "files": [
    "dist",
    "bin",
    "install.mjs",
    "install.sh",
    "uninstall.mjs",
    "uninstall.sh",
    "mcp-config.schema.json",
    ".env.example",
    "README.md",
    "SKILL.md",
    "FIGMA-DESIGN-GUIDELINES.md",
    "mcp-standalone.mjs",
    "LICENSE"
  ],
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@modelcontextprotocol/sdk": "^1.6.1",
    "axios": "^1.7.9",
    "boxen": "^8.0.1",
    "chalk": "^5.3.0",
    "clsx": "^2.1.1",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "fs-extra": "^11.2.0",
    "open": "^11.0.0",
    "ora": "^9.4.1",
    "prettier": "^3.4.2",
    "svgo": "^3.3.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.10.0",
    "@types/prettier": "^3.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "homepage": "https://gitee.com/shanxi-youcha/figma-dev-tools",
  "bugs": {
    "url": "https://gitee.com/shanxi-youcha/figma-dev-tools/issues"
  },
  "types": "dist/index.d.ts"
}
